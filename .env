# ضع رقم هاتف واتساب بصيغة دولية، مثل 15551234567، من دون علامات الاقتباس.
WHATSAPP_PHONE_NUMBER=9647756150033

# المشروع مخصص لـ Linux x86-64 ويضمّن yt-dlp 2026.10.26 داخل libraries/yt-dlp.
# لا تغيّر مسار yt-dlp من الإعدادات.

# يختار البوت تلقائيًا deno ثم node ثم bun.
# YTDLP_JS_RUNTIME=node

# ملف Cookies بصيغة Netscape مُصدّر من متصفحك (مفضّل للخوادم).
# لا ترفع هذا الملف إلى Git.
# YTDLP_COOKIES=youtube-cookies.txt

# بديل إذا كان المتصفح وملفاته متاحين على نفس الخادم.
# لا تستخدم المتغيرين معًا.
# YTDLP_COOKIES_FROM_BROWSER=chrome

# مسار ffmpeg اختياري؛ مطلوب فقط عند إضافة دمج أو تحويل لاحقًا.
# FFMPEG_PATH=libraries/ffmpeg

# هدف استخدام CPU المطبّع على حصة الحاوية. النطاق 1-100، الافتراضي 55.
CPU_EMA_TARGET_PERCENT=14

# وزن عينة CPU الجديدة في EMA. النطاق 0.05-0.8، الافتراضي 0.25.
CPU_EMA_ALPHA=0.4

# أقصى حجم وسيط مشفر يُحفظ في RAM (MB). الافتراضي 512؛ البوت يستخدم كذلك ربع الذاكرة المتاحة كحد أقصى.
# إذا تجاوز الملف الحد أو كانت الذاكرة المتاحة قليلة، يستخدم البوت ملفًا مؤقتًا على القرص.
UPLOAD_MEMORY_MAX_MB=512

# الافتراضي warn (تحذيرات وأخطاء فقط). استخدم info لإظهار التفاصيل أثناء التشخيص.
RUST_LOG=warn
